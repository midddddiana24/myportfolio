# ================================================================
# RM Portfolio — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git (it's in .gitignore)
# ================================================================

# ── EmailJS (Contact Form) ──────────────────────────────────────
# Get these from: https://www.emailjs.com
# 1. Create account → Add Email Service (Gmail)
# 2. Create Email Template — use variables:
#      {{to_name}}  {{from_name}}  {{from_email}}  {{subject}}  {{message}}
# 3. Copy IDs below

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Site URL (for OG + canonical) ──────────────────────────────
VITE_SITE_URL=https://rmjdev.vercel.app

# ── GitHub Username (for GitHub Stats section) ─────────────────
# Update in: src/components/home/GitHubStats.tsx → GITHUB_USERNAME
